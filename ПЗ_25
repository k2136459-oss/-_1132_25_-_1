/* ============ МОДУЛЬ 4: ОТПРАВКА В GOOGLE ТАБЛИЦУ (Вариант 3) ============ */
const MODULE_NAME = 'Вариант 3. Поступление материалов';
const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzkhyhLhN8ersBXddnKW9-MHh4u2zDU_Nk0lfyYnLxcThsPFyxpZ6oXwNu3jcemuS-X/exec';

document.getElementById('module4Form').addEventListener('submit', async function (e) {
  e.preventDefault();
  const form = this;
  const msg = document.getElementById('module4Message');
  const btn = form.querySelector('button[type="submit"]');

  const fields = {};
  new FormData(form).forEach((value, key) => {
    fields[key] = String(value).trim();
  });

  for (const [name, value] of Object.entries(fields)) {
    if (!value) {
      msg.textContent = 'Заполните поле: ' + name;
      msg.style.color = '#a83a35';
      return;
    }
  }

  const dataToSend = { module: MODULE_NAME, fields: fields };

  btn.disabled = true;
  msg.textContent = 'Отправка...';
  msg.style.color = '#2468a0';

  try {
    await fetch(SCRIPT_URL, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(dataToSend)
    });
    msg.textContent = 'Запрос отправлен. Проверьте таблицу.';
    msg.style.color = '#267747';
  } catch (err) {
    msg.textContent = 'Ошибка: ' + err.message;
    msg.style.color = '#a83a35';
  } finally {
    btn.disabled = false;
  }
});
</script>
