<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Инженерный дашборд дорожного строительства</title>
<style>
  :root {
    --bg: #f4f6f9;
    --card: #ffffff;
    --text: #1a2332;
    --muted: #5a6b7d;
    --accent: #2563eb;
    --accent-2: #10b981;
    --border: #dde3ea;
    --shadow: 0 4px 16px rgba(20, 35, 60, 0.08);
  }
  body.dark {
    --bg: #0f172a;
    --card: #1e293b;
    --text: #e8eef7;
    --muted: #94a3b8;
    --accent: #3b82f6;
    --accent-2: #34d399;
    --border: #334155;
    --shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    transition: background .3s, color .3s;
    min-height: 100vh;
  }
  header {
    background: var(--card);
    border-bottom: 1px solid var(--border);
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    box-shadow: var(--shadow);
    position: sticky; top: 0; z-index: 10;
  }
  h1 { font-size: 1.15rem; letter-spacing: .3px; }
  h1 span { color: var(--accent); }
  .theme-toggle {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 8px 14px;
    border-radius: 8px;
    cursor: pointer;
    font-size: .9rem;
    transition: .2s;
  }
  .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
  nav.nav-tabs {
    display: flex;
    gap: 6px;
    padding: 16px 24px 0;
    flex-wrap: wrap;
  }
  .tab-btn {
    background: transparent;
    border: 1px solid var(--border);
    border-bottom: none;
    color: var(--muted);
    padding: 10px 18px;
    border-radius: 10px 10px 0 0;
    cursor: pointer;
    font-size: .92rem;
    font-weight: 600;
    transition: .2s;
  }
  .tab-btn:hover { color: var(--accent); }
  .tab-btn.active {
    background: var(--card);
    color: var(--accent);
    border-color: var(--border);
    border-bottom: 2px solid var(--card);
    margin-bottom: -1px;
  }
  main { padding: 0 24px 40px; }
  .tab-panel { display: none; animation: fade .25s ease; }
  .tab-panel.active { display: block; }
  @keyframes fade { from { opacity: 0; transform: translateY(6px);} to {opacity:1; transform:none;} }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    margin-top: 18px;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px;
    box-shadow: var(--shadow);
  }
  .card h2 {
    font-size: 1.05rem;
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--accent);
    display: inline-block;
  }
  .field { margin-bottom: 14px; }
  .field label {
    display: block;
    font-size: .85rem;
    color: var(--muted);
    margin-bottom: 5px;
    font-weight: 600;
  }
  .field input, .field select, .field textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font-size: .95rem;
    font-family: inherit;
    transition: .2s;
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, .15);
  }
  .field input.invalid { border-color: #ef4444; }
  .error-msg { color: #ef4444; font-size: .78rem; margin-top: 4px; display: none; }
  .error-msg.show { display: block; }
  .btn-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px; }
  .btn {
    border: none;
    padding: 10px 18px;
    border-radius: 9px;
    cursor: pointer;
    font-size: .9rem;
    font-weight: 600;
    transition: .2s;
    background: var(--accent);
    color: #fff;
  }
  .btn:hover { filter: brightness(1.1); transform: translateY(-1px); }
  .btn.secondary { background: var(--bg); color: var(--text); border: 1px solid var(--border); }
  .btn.secondary:hover { border-color: var(--accent); color: var(--accent); }
  .btn.transfer { background: var(--accent-2); }
  .result-card {
    margin-top: 16px;
    background: linear-gradient(135deg, rgba(37,99,235,.08), rgba(16,185,129,.08));
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
  }
  .result-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px dashed var(--border);
  }
  .result-row:last-child { border-bottom: none; }
  .result-row .label { font-size: .85rem; color: var(--muted); }
  .result-row .value { font-size: 1.4rem; font-weight: 800; color: var(--accent); }
  .result-row .unit { font-size: .8rem; color: var(--muted); margin-left: 4px; }
  table.report {
    width: 100%;
    border-collapse: collapse;
    margin-top: 14px;
    font-size: .9rem;
  }
  table.report th, table.report td {
    border: 1px solid var(--border);
    padding: 10px 12px;
    text-align: left;
  }
  table.report th { background: var(--bg); font-weight: 700; }
  table.report td.num { text-align: right; font-weight: 600; color: var(--accent); }
  footer {
    text-align: center;
    padding: 18px;
    color: var(--muted);
    font-size: .78rem;
    border-top: 1px solid var(--border);
  }
  @media print {
    body { background: #fff !important; color: #000 !important; }
    header, nav.nav-tabs, .theme-toggle, .btn, footer, .no-print { display: none !important; }
    .tab-panel { display: block !important; page-break-after: always; }
    .card { box-shadow: none; border: 1px solid #000; }
    table.report th, table.report td { border: 1px solid #000 !important; }
    table.report th { background: #eee !important; }
    .result-row .value { color: #000 !important; }
  }
</style>
</head>
<body>

<header>
  <h1>Инженерный дашборд <span>дорожного строительства</span></h1>
  <button class="theme-toggle" onclick="toggleTheme()">🌓 Сменить тему</button>
</header>

<nav class="nav-tabs">
  <button class="tab-btn active" data-tab="tab1" onclick="switchTab('tab1', event)">Модуль 1: Бортовой камень</button>
  <button class="tab-btn" data-tab="tab2" onclick="switchTab('tab2', event)">Модуль 2: Потребность в щебне</button>
  <button class="tab-btn" data-tab="tab3" onclick="switchTab('tab3', event)">Модуль 3: Объём бетона стены</button>
  <button class="tab-btn" data-tab="tab4" onclick="switchTab('tab4', event)">Сводный отчёт</button>
</nav>

<main>

  <!-- ================= МОДУЛЬ 1 ================= -->
  <section id="tab1" class="tab-panel active">
    <div class="grid">
      <div class="card">
        <h2>Модуль 1: Расчёт бортового камня</h2>
        <div class="field">
          <label>Длина участка, L (м)</label>
          <input type="number" id="m1_L" min="0" step="0.1" value="100" oninput="calcModule1()">
          <div class="error-msg" id="err_m1_L">Значение не может быть отрицательным</div>
        </div>
        <div class="field">
          <label>Длина одного блока, l (м)</label>
          <input type="number" id="m1_l" min="0" step="0.01" value="1.00" oninput="calcModule1()">
          <div class="error-msg" id="err_m1_l">Значение не может быть отрицательным</div>
        </div>
        <div class="result-card">
          <div class="result-row">
            <span class="label">Необходимое количество</span>
            <span><span class="value" id="m1_N">100</span><span class="unit">шт.</span></span>
          </div>
        </div>
        <div class="btn-row">
          <button class="btn" onclick="calcModule1(true)">Рассчитать</button>
          <button class="btn secondary" onclick="resetModule1()">Сброс</button>
          <button class="btn transfer" onclick="transferToModule2()">Передать длину в Модуль 2 →</button>
        </div>
      </div>
      <div class="card">
        <h2>Формула</h2>
        <p style="color:var(--muted);line-height:1.7;font-size:.92rem;">
          <b>N = L / l</b><br>
          где N — необходимое количество бортовых камней (шт.);<br>
          L — длина участка (м);<br>
          l — длина одного блока (м).
        </p>
        <p style="margin-top:12px;color:var(--muted);font-size:.85rem;">
          <i>Передаваемый параметр:</i> <b>Длина участка L</b> → в Модуль 2 (Потребность в щебне).
        </p>
      </div>
    </div>
  </section>

  <!-- ================= МОДУЛЬ 2 ================= -->
  <section id="tab2" class="tab-panel">
    <div class="grid">
      <div class="card">
        <h2>Модуль 2: Потребность в щебне</h2>
        <div class="field">
          <label>Длина участка, L (м)</label>
          <input type="number" id="m2_L" min="0" step="0.1" value="100" oninput="calcModule2()">
          <div class="error-msg" id="err_m2_L">Значение не может быть отрицательным</div>
        </div>
        <div class="field">
          <label>Ширина, B (м)</label>
          <input type="number" id="m2_B" min="0" step="0.1" value="6" oninput="calcModule2()">
          <div class="error-msg" id="err_m2_B">Значение не может быть отрицательным</div>
        </div>
        <div class="field">
          <label>Толщина слоя, h (м)</label>
          <input type="number" id="m2_h" min="0" step="0.01" value="0.20" oninput="calcModule2()">
          <div class="error-msg" id="err_m2_h">Значение не может быть отрицательным</div>
        </div>
        <div class="field">
          <label>Коэффициент уплотнения, K</label>
          <input type="number" id="m2_K" min="0" step="0.01" value="1.25" oninput="calcModule2()">
        </div>
        <div class="result-card">
          <div class="result-row">
            <span class="label">Объём щебня, V</span>
            <span><span class="value" id="m2_V">150</span><span class="unit">м³</span></span>
          </div>
          <div class="result-row">
            <span class="label">Масса щебня, M</span>
            <span><span class="value" id="m2_M">270</span><span class="unit">т</span></span>
          </div>
        </div>
        <div class="btn-row">
          <button class="btn" onclick="calcModule2(true)">Рассчитать</button>
          <button class="btn secondary" onclick="resetModule2()">Сброс</button>
          <button class="btn transfer" onclick="transferToModule3()">Передать объём в Модуль 3 →</button>
        </div>
      </div>
      <div class="card">
        <h2>Формулы</h2>
        <p style="color:var(--muted);line-height:1.7;font-size:.92rem;">
          <b>V = L · B · h · K</b><br>
          <b>M = V · ρ</b><br>
          где V — объём щебня (м³); M — масса (т); ρ = 1,8 т/м³ — плотность щебня.
        </p>
        <p style="margin-top:12px;color:var(--muted);font-size:.85rem;">
          <i>Принимает:</i> L из Модуля 1.<br>
          <i>Передаёт:</i> V → в Модуль 3 (Объём бетона стены).
        </p>
      </div>
    </div>
  </section>

  <!-- ================= МОДУЛЬ 3 ================= -->
  <section id="tab3" class="tab-panel">
    <div class="grid">
      <div class="card">
        <h2>Модуль 3: Объём бетона стены</h2>
        <div class="field">
          <label>Ширина верха, a (м)</label>
          <input type="number" id="m3_a" min="0" step="0.01" value="0.5" oninput="calcModule3()">
        </div>
        <div class="field">
          <label>Ширина низа, b (м)</label>
          <input type="number" id="m3_b" min="0" step="0.01" value="1.0" oninput="calcModule3()">
        </div>
        <div class="field">
          <label>Высота, H (м)</label>
          <input type="number" id="m3_H" min="0" step="0.01" value="2" oninput="calcModule3()">
        </div>
        <div class="field">
          <label>Длина стены, L (м)</label>
          <input type="number" id="m3_L" min="0" step="0.1" value="10" oninput="calcModule3()">
        </div>
        <div class="result-card">
          <div class="result-row">
            <span class="label">Объём бетона, V</span>
            <span><span class="value" id="m3_V">15.00</span><span class="unit">м³</span></span>
          </div>
        </div>
        <div class="btn-row">
          <button class="btn" onclick="calcModule3(true)">Рассчитать</button>
          <button class="btn secondary" onclick="resetModule3()">Сброс</button>
        </div>
      </div>
      <div class="card">
        <h2>Формула</h2>
        <p style="color:var(--muted);line-height:1.7;font-size:.92rem;">
          <b>V = (a + b) / 2 · H · L</b><br>
          где V — объём бетона (м³); a, b — ширины верха и низа (м); H — высота (м); L — длина (м).
        </p>
      </div>
    </div>
  </section>

  <!-- ================= СВОДНЫЙ ОТЧЁТ ================= -->
  <section id="tab4" class="tab-panel">
    <div class="card">
      <h2>Сводный отчёт по проекту</h2>
      <div class="btn-row no-print">
        <button class="btn" onclick="buildReport()">Сформировать отчёт</button>
        <button class="btn secondary" onclick="saveProject()">💾 Сохранить проект</button>
        <button class="btn secondary" onclick="window.print()">🖨 Печать / Экспорт в PDF</button>
      </div>
      <div id="reportArea">
        <table class="report">
          <thead>
            <tr>
              <th>Модуль</th>
              <th>Входные данные</th>
              <th>Результат</th>
            </tr>
          </thead>
          <tbody id="reportBody"></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ================= МОДУЛЬ 4 (ПЗ №25, Вариант 3) ================= -->
  <section id="module4" style="margin-top:40px;padding:25px;background:#f8fbfe;border-radius:12px;border:1px solid #d7e1eb;">
    <h2 style="color:#1a2332;">Модуль 4: Поступление материалов</h2>
    <form id="module4Form">
      <div class="field" style="margin-bottom:12px;">
        <label for="m4_date" style="color:#1a2332;">Дата</label>
        <input type="date" id="m4_date" name="Дата" required>
      </div>
      <div class="field" style="margin-bottom:12px;">
        <label for="m4_material" style="color:#1a2332;">Материал</label>
        <input type="text" id="m4_material" name="Материал" required placeholder="Например: Бортовой камень БР 100.30.15">
      </div>
      <div class="field" style="margin-bottom:12px;">
        <label for="m4_qty" style="color:#1a2332;">Количество</label>
        <input type="number" id="m4_qty" name="Количество" min="0.01" step="0.01" required placeholder="Больше 0">
      </div>
      <div class="field" style="margin-bottom:12px;">
        <label for="m4_unit" style="color:#1a2332;">Единица измерения</label>
        <select id="m4_unit" name="Единица" required>
          <option value="">--- выберите ---</option>
          <option>м³</option>
          <option>т</option>
          <option>шт.</option>
          <option>м²</option>
          <option>м.п.</option>
        </select>
      </div>
      <button type="submit" class="btn" style="margin-top:8px;">Сохранить в таблицу</button>
      <p id="module4Message" style="margin-top:10px;font-weight:700;"></p>
    </form>
  </section>

</main>

<footer>ПЗ №25 · Группа 1132 · Плугатырева К.А. · 2026</footer>

<script>
/* ============ СОСТОЯНИЕ ============ */
const state = {
  m1: { L: 100, l: 1.00, N: 100 },
  m2: { L: 100, B: 6, h: 0.20, K: 1.25, V: 150, M: 270 },
  m3: { a: 0.5, b: 1.0, H: 2, L: 10, V: 15.00 },
  theme: 'light'
};

/* ============ ТЕМА ============ */
function toggleTheme() {
  document.body.classList.toggle('dark');
  state.theme = document.body.classList.contains('dark') ? 'dark' : 'light';
  localStorage.setItem('dashboardTheme', state.theme);
}
(function initTheme() {
  const saved = localStorage.getItem('dashboardTheme');
  if (saved === 'dark') document.body.classList.add('dark');
})();

/* ============ ПЕРЕКЛЮЧЕНИЕ ВКЛАДОК ============ */
function switchTab(id, e) {
  if (e) e.preventDefault();
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  const btn = document.querySelector(`.tab-btn[data-tab="${id}"]`);
  if (btn) btn.classList.add('active');
  if (id === 'tab4') buildReport();
}

/* ============ ВАЛИДАЦИЯ ============ */
function validate(id, errId) {
  const el = document.getElementById(id);
  const err = document.getElementById(errId);
  const v = parseFloat(el.value);
  if (isNaN(v) || v < 0) {
    el.classList.add('invalid');
    if (err) err.classList.add('show');
    return false;
  }
  el.classList.remove('invalid');
  if (err) err.classList.remove('show');
  return true;
}

/* ============ МОДУЛЬ 1 ============ */
function calcModule1(show) {
  const okL = validate('m1_L', 'err_m1_L');
  const okl = validate('m1_l', 'err_m1_l');
  if (!okL || !okl) return;
  const L = parseFloat(document.getElementById('m1_L').value) || 0;
  const l = parseFloat(document.getElementById('m1_l').value) || 0;
  let N = (l > 0) ? L / l : 0;
  N = Math.round(N);
  document.getElementById('m1_N').textContent = N;
  state.m1 = { L, l, N };
  if (show) buildReport();
}
function resetModule1() {
  document.getElementById('m1_L').value = 100;
  document.getElementById('m1_l').value = 1.00;
  calcModule1();
}
function transferToModule2() {
  document.getElementById('m2_L').value = state.m1.L;
  calcModule2();
  switchTab('tab2');
}

/* ============ МОДУЛЬ 2 ============ */
function calcModule2(show) {
  const okL = validate('m2_L', 'err_m2_L');
  const okB = validate('m2_B', 'err_m2_B');
  const okh = validate('m2_h', 'err_m2_h');
  if (!okL || !okB || !okh) return;
  const L = parseFloat(document.getElementById('m2_L').value) || 0;
  const B = parseFloat(document.getElementById('m2_B').value) || 0;
  const h = parseFloat(document.getElementById('m2_h').value) || 0;
  const K = parseFloat(document.getElementById('m2_K').value) || 0;
  const rho = 1.8;
  const V = L * B * h * K;
  const M = V * rho;
  document.getElementById('m2_V').textContent = V.toFixed(2);
  document.getElementById('m2_M').textContent = M.toFixed(2);
  state.m2 = { L, B, h, K, V, M };
  if (show) buildReport();
}
function resetModule2() {
  document.getElementById('m2_L').value = 100;
  document.getElementById('m2_B').value = 6;
  document.getElementById('m2_h').value = 0.20;
  document.getElementById('m2_K').value = 1.25;
  calcModule2();
}
function transferToModule3() {
  document.getElementById('m3_L').value = Math.round(state.m2.V);
  calcModule3();
  switchTab('tab3');
}

/* ============ МОДУЛЬ 3 ============ */
function calcModule3(show) {
  const a = parseFloat(document.getElementById('m3_a').value) || 0;
  const b = parseFloat(document.getElementById('m3_b').value) || 0;
  const H = parseFloat(document.getElementById('m3_H').value) || 0;
  const L = parseFloat(document.getElementById('m3_L').value) || 0;
  const V = ((a + b) / 2) * H * L;
  document.getElementById('m3_V').textContent = V.toFixed(2);
  state.m3 = { a, b, H, L, V };
  if (show) buildReport();
}
function resetModule3() {
  document.getElementById('m3_a').value = 0.5;
  document.getElementById('m3_b').value = 1.0;
  document.getElementById('m3_H').value = 2;
  document.getElementById('m3_L').value = 10;
  calcModule3();
}

/* ============ СВОДНЫЙ ОТЧЁТ ============ */
function buildReport() {
  const tbody = document.getElementById('reportBody');
  tbody.innerHTML = `
    <tr>
      <td>Модуль 1: Бортовой камень</td>
      <td>L = ${state.m1.L} м; l = ${state.m1.l} м</td>
      <td class="num">N = ${state.m1.N} шт.</td>
    </tr>
    <tr>
      <td>Модуль 2: Потребность в щебне</td>
      <td>L = ${state.m2.L} м; B = ${state.m2.B} м; h = ${state.m2.h} м; K = ${state.m2.K}</td>
      <td class="num">V = ${state.m2.V.toFixed(2)} м³; M = ${state.m2.M.toFixed(2)} т</td>
    </tr>
    <tr>
      <td>Модуль 3: Объём бетона стены</td>
      <td>a = ${state.m3.a} м; b = ${state.m3.b} м; H = ${state.m3.H} м; L = ${state.m3.L} м</td>
      <td class="num">V = ${state.m3.V.toFixed(2)} м³</td>
    </tr>
  `;
}

